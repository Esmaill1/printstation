# PrintStation Backend Configuration
# Copy this to .env and fill in your values

# Gemini API Key (optional — runs in simulation mode without it)
# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=

# Database (Neon PostgreSQL or SQLite)
DATABASE_URL=postgresql://user:password@ep-xyz.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 Cloud File Storage (Optional — 10GB free forever)
# Get keys from Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=printstation-files
