# Required
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/printstation
UPLOAD_DIR=./uploads
AI_OUTPUT_DIR=./ai_output

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# AI (leave empty to run in simulation mode)
GEMINI_API_KEY=

# Payment (leave empty for simulated payments)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=

# Auth (leave empty to allow anonymous uploads)
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Kiosk auth (comma-separated list of valid API keys)
KIOSK_API_KEYS=test-kiosk-key-dev

# App settings
DEBUG=true
MAX_UPLOAD_SIZE_MB=50
MAX_PAGES=500
PICKUP_CODE_EXPIRY_HOURS=24
